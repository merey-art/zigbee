# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/Warsaw

# ── Zigbee dongle USB device path ─────────────────────────────────────────────
# Change to /dev/ttyACM0 for some SONOFF Zigbee Dongle-E variants
ZIGBEE_DEVICE=/dev/ttyUSB0

# ── PostgreSQL / TimescaleDB ───────────────────────────────────────────────────
POSTGRES_DB=zigbee
POSTGRES_USER=zigbee
POSTGRES_PASSWORD=change_me_in_production

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_PORT=1883

# ── Auth / JWT ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRE_MINUTES=480

# ── Telegram alerts (optional; BotFather token) ───────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...

# ── Backend CORS (browser origin hitting nginx — port 80 default) ────────────
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ── Published web port (nginx + SPA) ─────────────────────────────────────────
HTTP_PORT=80

# ── Frontend build-time (optional; leave unset for Docker — uses `/api` + `/ws`) ─
# For local `vite` against a backend on another host only:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# ── Emergency alarm detection (hard-coded backend rule) ───────────────────────
EMERGENCY_TEMP_RATE=2.0
EMERGENCY_CO2_RATE=200
EMERGENCY_TEMP_ABSOLUTE=35
EMERGENCY_SUSTAINED_READINGS=2
# Format: zone-a:temp_device_id:co2_device_id,zone-b:temp_device_id:co2_device_id
EMERGENCY_DEVICE_PAIRS=
